{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://wax.dev/schemas/scan-summary.v1.schema.json",
  "title": "Scan JSON summary",
  "description": "Stable, versioned scan summary for CI and dashboards. Optional `deltas` may be present when a baseline comparison was requested.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "generated_at",
    "repo_root",
    "scan_path",
    "snapshot_ids",
    "languages",
    "adoption",
    "diagnostics",
    "artifacts",
    "limits"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "repo_root": {
      "type": "string",
      "minLength": 1
    },
    "scan_path": {
      "type": "string",
      "minLength": 1
    },
    "snapshot_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "languages": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "version",
          "status",
          "parser",
          "files_scanned",
          "resolved",
          "candidate"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "version": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": ["complete", "partial", "failed"]
          },
          "parser": {
            "type": "string"
          },
          "files_scanned": {
            "type": "integer",
            "minimum": 0
          },
          "coverage_ratio": {
            "type": ["number", "null"]
          },
          "resolved": {
            "type": "integer",
            "minimum": 0
          },
          "candidate": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    },
    "adoption": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "coverage_ratio",
        "eligible_invocation_count",
        "adopted_invocation_count",
        "non_adopted_invocation_count",
        "adoption_excluded_invocation_count",
        "raw_invocations"
      ],
      "properties": {
        "coverage_ratio": {
          "type": ["number", "null"]
        },
        "eligible_invocation_count": {
          "type": "integer",
          "minimum": 0
        },
        "adopted_invocation_count": {
          "type": "integer",
          "minimum": 0
        },
        "non_adopted_invocation_count": {
          "type": "integer",
          "minimum": 0
        },
        "adoption_excluded_invocation_count": {
          "type": "integer",
          "minimum": 0
        },
        "raw_invocations": {
          "type": "object",
          "additionalProperties": false,
          "required": ["total", "resolved", "local", "candidate", "unresolved"],
          "properties": {
            "total": {
              "type": "integer",
              "minimum": 0
            },
            "resolved": {
              "type": "integer",
              "minimum": 0
            },
            "local": {
              "type": "integer",
              "minimum": 0
            },
            "candidate": {
              "type": "integer",
              "minimum": 0
            },
            "unresolved": {
              "type": "integer",
              "minimum": 0
            }
          }
        }
      }
    },
    "diagnostics": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["severity", "code", "message", "language"],
        "properties": {
          "severity": {
            "type": "string",
            "enum": ["error", "warning", "info"]
          },
          "code": {
            "type": "string"
          },
          "message": {
            "type": "string"
          },
          "language": {
            "type": "string"
          },
          "location": {
            "type": "object",
            "additionalProperties": false,
            "required": ["file", "line"],
            "properties": {
              "file": {
                "type": "string"
              },
              "line": {
                "type": "integer",
                "minimum": 0
              },
              "column": {
                "type": "integer",
                "minimum": 0
              }
            }
          }
        }
      }
    },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["format", "path"],
        "properties": {
          "format": {
            "type": "string"
          },
          "path": {
            "type": "string"
          },
          "bytes": {
            "type": ["integer", "null"],
            "minimum": 0
          }
        }
      }
    },
    "limits": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "deltas": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "adoption_coverage_delta",
        "resolved_delta",
        "candidate_delta",
        "new_error_diagnostics",
        "resolved_diagnostics"
      ],
      "properties": {
        "adoption_coverage_delta": {"type": ["number", "null"]},
        "resolved_delta": {"type": "integer"},
        "candidate_delta": {"type": "integer"},
        "new_error_diagnostics": {
          "type": "array",
          "items": {"$ref": "#/$defs/diagnosticRef"}
        },
        "resolved_diagnostics": {
          "type": "array",
          "items": {"$ref": "#/$defs/diagnosticRef"}
        }
      }
    }
  },
  "$defs": {
    "diagnosticRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "message", "language"],
      "properties": {
        "code": {"type": "string"},
        "message": {"type": "string"},
        "language": {"type": ["string", "null"]},
        "location": {
          "type": "object",
          "additionalProperties": false,
          "required": ["file", "line"],
          "properties": {
            "file": {"type": "string"},
            "line": {"type": "integer", "minimum": 0},
            "column": {"type": "integer", "minimum": 0}
          }
        }
      }
    }
  }
}
